[Unit]
Description=Back up the Zdaj Egzamin INF PostgreSQL database
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/zdaj-egzamin-inf
ExecStart=/usr/bin/python3 /opt/zdaj-egzamin-inf/backup.py
UMask=0077
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=25min
NoNewPrivileges=true
PrivateTmp=true
