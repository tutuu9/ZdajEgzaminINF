# Run npm run setup:local to generate a private local configuration.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql://zdaj:replace-with-a-long-random-local-password@127.0.0.1:54329/zdaj
DATA_DIR=./data
# Absolute host path; on Windows use forward slashes, e.g. C:/Projects/ZdajEgzaminINF/data.
DATA_DIR_HOST=/absolute/path/to/ZdajEgzaminINF/data
PORT=3001
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173
SESSION_SECRET=replace-with-a-long-random-value
IP_HASH_SECRET=replace-with-a-different-long-random-value
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
RUNNER_PROFILE=local-development
SANDBOX_IMAGE=zdaj-inf-sandbox:0.3.1
PUBLIC_SANDBOX_VERIFIED=false
COOKIE_SECURE=false
TRUST_PROXY=false
