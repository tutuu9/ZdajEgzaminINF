# Copy to /opt/zdaj-egzamin-inf/.env, mode 0600. Never commit the filled file.
# Build and transfer this image from the verified commit; the VPS does not build it.
SITE_IMAGE=zdaj-inf-site:git-REPLACE_WITH_VERIFIED_40_CHARACTER_SHA
POSTGRES_IMAGE=postgres:17-bookworm
PUBLIC_WEB_ORIGIN=https://zdajegzamin.sbs
# Use a new URL-safe random value (for example 32 random bytes encoded as hex).
POSTGRES_PASSWORD=REPLACE_WITH_NEW_RANDOM_HEX_PASSWORD
APP_SECRET=REPLACE_WITH_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
IP_HASH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Inspect the new Compose network after starting only postgres.
# Set its exact gateway, e.g. 172.30.0.1/32. Do not trust a whole private subnet.
PUBLIC_TRUST_PROXY=REPLACE_WITH_EXACT_DOCKER_GATEWAY_IP
