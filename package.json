{
  "name": "zdaj-egzamin-inf",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @zdaj/api\" \"npm run dev -w @zdaj/web\"",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test",
    "test:api": "vitest run --config vitest.integration.config.ts tests/api.integration.test.ts tests/faq.integration.test.ts",
    "test:checker": "vitest run --config vitest.integration.config.ts tests/checker.integration.test.ts tests/isolation.integration.test.ts tests/study-checker.integration.test.ts tests/new-study-runtime.integration.test.ts",
    "test:integration": "npm run test:api && npm run test:checker",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "site:initialize": "tsx packages/database/src/initialize-site.ts",
    "admin:create": "tsx apps/api/src/create-admin.ts",
    "sandbox:build": "docker build -t zdaj-inf-sandbox:0.1.0 infra/sandbox",
    "worker": "tsx apps/worker/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.0",
    "prisma": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.0",
    "vite": "^7.3.0"
  }
}
